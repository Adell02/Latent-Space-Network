            "num_steps": 1,
            "learning_rate": 0.1
        },
        "inference": {
            "enabled": true,
            "num_steps": 100,
            "learning_rate": 0.1
        },
        "method": "gradient",
        "evolutionary": {
            "population_size": 20,
            "num_generations": 15,
            "mutation_std": 0.1
        },
        "voronoi": {
            "population_size": 20,
            "num_generations": 15,
            "diversity_weight": 0.5,
            "mutation_std": 0.1
        }
    },
    "evaluation_settings": {
        "eval_keys": [
            "pattern_task"
        ],
        "eval_n_samples": 5,
        "eval_n_queries": 50,
        "eval_epoch": 10,
        "visualize_n_values": 5
    }
