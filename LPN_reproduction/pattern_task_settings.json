{
    "data_settings": {
        "training_keys": [
            "pattern_task"
        ],
        "training_seed": 42,
        "eval_seed": 1,
        "n": 20,
        "n_pairs": 4,
        "run_base_dir": "runs_re_arc"
    },
    "model_architecture": {
        "latent_dim": 2,
        "hidden_dim": 2,
        "num_layers": 1,
        "num_heads": 2,
        "dropout": 0.15,
        "max_length": 902,
        "encoder_max_length": 1805,
        "decoder_max_length": 902,
        "use_gradient_checkpointing": true
    },
    "training_settings": {
        "num_epochs": 5,
        "batch_size": 8,
        "gradient_accumulation_steps": 1,
        "learning_rate": 4e-4,
        "optimizer_weight_decay": 1e-2,
        "beta": 0.1,
        "use_mixed_precision": true,
        "save_checkpoint_interval": 50,
        "learning_rate_scheduler": {
            "type": "cosine",
            "warmup_epochs": 1000,
            "lr_min": 1e-4
        }
    },
    "latent_optimization": {
        "training": {
            "enabled": true,
            "num_steps": 1,
            "learning_rate": 0.1
        },
        "inference": {
            "enabled": true,
            "num_steps": 100,
            "learning_rate": 0.1
        },
        "method": "gradient",
        "evolutionary": {
            "population_size": 20,
            "num_generations": 15,
            "mutation_std": 0.1
        },
        "voronoi": {
            "population_size": 20,
            "num_generations": 15,
            "diversity_weight": 0.5,
            "mutation_std": 0.1
        }
    },
    "evaluation_settings": {
        "eval_keys": ["pattern_task"],
        "eval_n_samples": 1,
        "eval_n_queries": 10,
        "eval_epoch": 10,
        "visualize_n_values": 2
    }
} 