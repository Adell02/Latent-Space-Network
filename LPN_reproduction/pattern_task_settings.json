        "max_length": 902,
        "encoder_max_length": 1805,
        "decoder_max_length": 902,
        "use_gradient_checkpointing": true
    },
    "training_settings": {
        "num_epochs": 10,
        "batch_size": 16,
        "gradient_accumulation_steps": 2,
        "learning_rate": 0.0004,
        "optimizer_weight_decay": 1e-05,
